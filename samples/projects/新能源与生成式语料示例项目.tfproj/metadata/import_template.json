{
  "id": "template-default",
  "name": "通用导入模板",
  "source_profile": "generic",
  "description": "支持标题、摘要、claims 等字段拼接为主文本。",
  "field_mappings": [
    {
      "source_field": "doc_id",
      "target_field": "doc_id",
      "required": false
    },
    {
      "source_field": "title",
      "target_field": "title",
      "required": false
    },
    {
      "source_field": "abstract",
      "target_field": "raw_text",
      "required": false
    },
    {
      "source_field": "year",
      "target_field": "year",
      "required": false
    },
    {
      "source_field": "source",
      "target_field": "source",
      "required": false
    },
    {
      "source_field": "author",
      "target_field": "author",
      "required": false
    },
    {
      "source_field": "institution",
      "target_field": "institution",
      "required": false
    },
    {
      "source_field": "country_or_region",
      "target_field": "country_or_region",
      "required": false
    },
    {
      "source_field": "category_or_tag",
      "target_field": "category_or_tag",
      "required": false
    },
    {
      "source_field": "keyword_field",
      "target_field": "keyword_field",
      "required": false
    }
  ],
  "text_build": {
    "mode": "concat_fields",
    "fields": [
      "title",
      "abstract"
    ],
    "delimiter": "\n\n",
    "skip_empty": true
  }
}